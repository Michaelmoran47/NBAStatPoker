# Copy this file to .env (in this same server/ folder) and fill in real values.
# .env is gitignored — never commit real secrets.

# Signs session cookies. Any long random string. If left unset, the server generates
# a random one at boot, but then everyone gets logged out on every restart.
SESSION_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Application type: Web application). Only the Client ID is needed — this app
# verifies ID tokens client-side-issued by Google Identity Services, which doesn't
# require a client secret. Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=

# Username of the one account allowed to open the private stats page at /admin/stats.
# Leave blank and the page (and its data) stays hidden from everyone.
ADMIN_USERNAME=

# From resend.com > API Keys. Used to send password-reset emails (and, later, report
# notifications). Without it, those emails are skipped and just logged to the console —
# fine for local dev, required for anything real.
RESEND_API_KEY=

# The "From" address on emails this server sends. Must be at a domain verified in Resend.
FROM_EMAIL=Quantrivia <no-reply@playquantrivia.com>

# The public base URL of this site, used to build links inside emails (e.g. the password
# reset link). Defaults to localhost, which is fine for local dev only.
BASE_URL=http://localhost:5500

# Where player reports get emailed. Defaults to the contact address already set up with
# Cloudflare Email Routing, which forwards to the operator's own inbox.
REPORT_EMAIL=contact@playquantrivia.com
