# Copy this file to .env (in this same server/ folder) and fill in real values.
# .env is gitignored — never commit real secrets.

# Signs session cookies. Any long random string. If left unset, the server generates
# a random one at boot, but then everyone gets logged out on every restart.
SESSION_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Application type: Web application). Only the Client ID is needed — this app
# verifies ID tokens client-side-issued by Google Identity Services, which doesn't
# require a client secret. Leave blank to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
